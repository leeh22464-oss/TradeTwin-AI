# Optional. No model credential is required for the labelled local demo.
# Official OpenAI Responses/web_search mode (server-only; never expose this key
# to the browser). OPENAI_MODEL defaults to gpt-4.1 when omitted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Legacy OpenAI-compatible chat/completions mode. An LLM_API_KEY is accepted
# by the official Responses adapter only when this base is exactly api.openai.com.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
PORT=3001
# npm run dev / npm start manage both APIs on loopback. Custom ports must differ.
VITE_PORT=5173
WORKFLOW1_URL=http://127.0.0.1:8000
# Optional executable path (no arguments). Default: root .venv, then PATH Python.
WORKFLOW1_PYTHON=
# The supervisor sets Python's WORKFLOW2_MODE=http and WORKFLOW2_URL to
# http://127.0.0.1:<PORT>/api/workflow2. It never installs Python packages on launch.
# Set up once, in the selected Python environment:
# python -m pip install -r workflow-1/app/requirements.txt
# Optional isolated Python session/mail settings directory; default: workflow-1/app/runtime.
TRADETWIN_RUNTIME_DIR=
# Optional smoke target. Default: http://127.0.0.1:<PORT>.
TRADETWIN_API_URL=
DATA_DIR=./data
# Optional fixed package directory; request bodies cannot override it.
KNOWLEDGE_PACKAGE_PATH=./knowledge-base(2)
# Optional research timeout, clamped to 90 seconds (default 45 seconds).
KNOWLEDGE_RESEARCH_TIMEOUT_MS=45000
# Optional explicit read-only Markdown import; no automatic home-directory scan.
OBSIDIAN_VAULT_PATH=
