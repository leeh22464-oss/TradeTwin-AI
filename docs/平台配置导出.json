      "category": "mapping",
      "version": "rules-2026.10.31-demo.v1"
    },
    {
      "id": "R-EMC-001",
      "title": "EMC 独立条件",
      "description": "EMC 可沿用需要驱动、功率、系列、材料和市场等条件共同匹配。",
      "category": "mapping",
      "version": "rules-2026.10.31-demo.v1"
    },
    {
