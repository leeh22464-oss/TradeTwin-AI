      }
    },
    {
      "id": "RULE-VOLTAGE-001",
      "title": "输入电压字段一致性",
      "description": "规格书、DoC、测试报告和标签的输入电压范围不应无依据地互相冲突。发现冲突后要求工程/品质确认真实配置和报告覆盖关系。",
      "category": "documents",
      "version": "rules-2026.10.31-demo.v2+kb.0.2.0",
      "knowledgeSource": {
        "path": "knowledge-base(2)/public-rules/rule-cards.jsonl",
