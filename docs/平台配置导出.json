  "rules": [
    {
      "id": "RULE-DOC-IDENTITY-001",
      "title": "跨文件型号身份一致性",
      "description": "规格书、DoC、测试报告、标签中的型号/SKU应与已确认配置一致。冲突只说明需要阻断式复核，不自动认定违法或无法清关。",
      "category": "documents",
      "version": "rules-2026.10.31-demo.v2+kb.0.2.0",
      "knowledgeSource": {
        "path": "knowledge-base(2)/public-rules/rule-cards.jsonl",
