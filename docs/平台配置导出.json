      }
    },
    {
      "id": "RULE-RATED-POWER-001",
      "title": "额定功率一致性",
      "description": "规格书、DoC、报告、标签中的额定功率与当前配置一致。数值冲突是硬伤候选；不能仅凭冲突断言适用法规结论。",
      "category": "documents",
      "version": "rules-2026.10.31-demo.v2+kb.0.2.0",
      "knowledgeSource": {
        "path": "knowledge-base(2)/public-rules/rule-cards.jsonl",
