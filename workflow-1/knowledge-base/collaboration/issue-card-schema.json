{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tradetwin/issue-card.schema.json",
  "title": "TradeTwin AI Issue Card",
  "type": "object",
  "required": ["issue_id", "pack_id", "category", "severity", "status", "owner_role", "evidence", "finding", "next_action", "human_decision", "decision_by", "closed_at", "coverage_status", "quote_assumption", "human_confirmed"],
  "properties": {
    "issue_id": {"type": "string", "pattern": "^ISSUE-[A-Z0-9-]+$"},
    "pack_id": {"type": "string", "enum": ["PACK-BASELINE-001", "PACK-CONFLICT-001", "PACK-MISSING-001"]},
    "category": {"type": "string", "enum": ["identity_conflict", "rated_value_conflict", "version_conflict", "missing_document", "evidence_quality", "applicability", "coverage_range", "retest_plan", "document_update", "quote_assumption"]},
    "severity": {"type": "string", "enum": ["HARD_ISSUE_CANDIDATE", "RECOMMENDATION", "MANUAL_REVIEW", "NO_ISSUE_FOUND_IN_SCOPE"]},
    "status": {"type": "string", "enum": ["OPEN", "WAITING_ENGINEERING", "WAITING_QUALITY", "WAITING_LAB_PURCHASING", "WAITING_SALES", "RESOLVED", "MANUAL_REVIEW"]},
    "owner_role": {"type": "string", "enum": ["SALES", "ENGINEERING", "QUALITY_COMPLIANCE", "LAB_PURCHASING"]},
    "coverage_status": {"type": ["string", "null"], "enum": ["COVERED", "NEEDS_RETEST", "DOCUMENT_UPDATE", "MANUAL_REVIEW", "NOT_ENOUGH_EVIDENCE", null]},
    "test_item": {"type": ["string", "null"]},
    "quote_assumption": {"type": ["string", "null"]},
    "estimated_cost_eur": {"type": ["number", "null"], "minimum": 0},
    "estimated_days": {"type": ["integer", "null"], "minimum": 0},
    "human_confirmed": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "page", "quote", "source_type"],
        "properties": {
          "document_id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "quote": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "enum": ["synthetic_document", "public_rule_index", "canonical_product"]}
        }
      }
    },
    "finding": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "human_decision": {"type": "string", "minLength": 1},
    "decision_by": {"type": "string", "minLength": 1},
    "closed_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
