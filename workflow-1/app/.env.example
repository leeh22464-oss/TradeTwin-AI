# 复制为 .env 后填写；全部留空也能运行（规则模板 + 离线邮件样例）。

# 工作流二（证据覆盖与补测代价）接入方式，契约见 docs/workflow2-contract.md
# local = 本仓库参考实现；python = 队友的 Python 模块；http = 队友的服务
WORKFLOW2_MODE=local
WORKFLOW2_MODULE=
WORKFLOW2_URL=
WORKFLOW2_TIMEOUT=15

# 任意 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / OpenAI 等）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=40

# IMAP 邮箱：密码处填邮箱的“授权码 / 应用专用密码”，不是登录密码
# QQ 邮箱 imap.qq.com · 163 邮箱 imap.163.com · Gmail imap.gmail.com · Outlook outlook.office365.com
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_USER=
MAIL_PASSWORD=
# 自动识别失败时手动指定草稿箱（IMAP 文件夹名），例如 Drafts；中文“草稿箱”写作 &g0l6P3ux-
MAIL_DRAFTS_FOLDER=
MAIL_FETCH_LIMIT=30
MAIL_SIGNATURE=NordLuma Lighting Sales Team
